{
  "name": "ever-better",
  "version": "0.1.0",
  "description": "Diagnose a repository, install the quality tooling it is missing, and pin a baseline that can only get better.",
  "keywords": [
    "eslint",
    "ratchet",
    "baseline",
    "suppressions",
    "code-quality",
    "refactoring",
    "technical-debt",
    "claude-code"
  ],
  "homepage": "https://github.com/isamu/ever-better",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isamu/ever-better.git"
  },
  "license": "MIT",
  "author": "isamu",
  "type": "module",
  "bin": {
    "ever-better": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"test/*.ts\"",
    "prepack": "yarn build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-sonarjs": "^4.2.0",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0"
  }
}
