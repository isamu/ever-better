{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["src/cli.ts", "src/index.ts", "test/*.ts", "formatters/rule-counts.js"],
  "project": ["src/**/*.ts", "formatters/**/*.js"],
  "rules": {
    "exports": "warn",
    "types": "warn",
    "files": "warn",
    "dependencies": "warn",
    "devDependencies": "warn",
    "unlisted": "warn",
    "binaries": "warn"
  }
}
